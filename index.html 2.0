<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Vibe Dashboard</title>
<style>
    :root { --bg: #080808; --surface: #111111; --text: #f5f5f5; --accent: #c8ff00; }
    body { background: var(--bg); color: var(--text); font-family: sans-serif; padding: 20px; margin: 0; }
    .vibe-card { background: var(--surface); border: 1px solid #333; border-radius: 16px; padding: 16px; margin-bottom: 20px; }
    iframe { width: 100%; border: none; border-radius: 12px; }
    button { background: var(--accent); border: none; padding: 12px; width: 100%; border-radius: 8px; font-weight: bold; cursor: pointer; }
    #result { margin-top: 15px; color: #888; }
</style>
</head>
<body>

    <div class="vibe-card">
        <div id="live-clock" style="font-size: 24px; font-weight: bold;">--:--:--</div>
    </div>

    <div class="vibe-card">
        <iframe src="https://open.spotify.com/embed/playlist/2CYaNy5UXj7YEC1ObftXgG?utm_source=generator" height="152"></iframe>
        <iframe src="https://open.spotify.com/embed/playlist/7jSnO8TrhskDCXGso3ssn2?utm_source=generator" height="152" style="margin-top:10px;"></iframe>
    </div>

    <div class="vibe-card">
        <iframe src="https://steamid.uk/profile/76561199709660579" height="300"></iframe>
    </div>

    <div class="vibe-card">
        <button onclick="getRecommendation()">Get Vibe Check</button>
        <div id="result">Click for a vibe check.</div>
    </div>

<script>
    function updateClock() {
        document.getElementById('live-clock').innerText = new Date().toLocaleTimeString();
    }
    setInterval(updateClock, 1000);
    updateClock();

    function getRecommendation() {
        const SUGGESTIONS = ["Zone out with a game.", "Listen to your top playlist.", "Focus mode: On.", "Take a break, you've earned it."];
        document.getElementById('result').innerText = SUGGESTIONS[Math.floor(Math.random() * SUGGESTIONS.length)];
    }
</script>
</body>
</html>
