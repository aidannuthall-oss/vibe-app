<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Vibe Dashboard</title>
    <style>
        :root { --bg: #080808; --surface: #111111; --text: #f5f5f5; --accent: #c8ff00; }
        body { background: var(--bg); color: var(--text); font-family: sans-serif; padding: 20px; transition: background 1s; }
        /* Moods: Classes added by JS */
        .morning { border-top: 5px solid #FFD54F; }
        .evening { border-top: 5px solid #ff6b35; }
        .night { background: #000; border-top: 5px solid #3a2060; }
        
        .vibe-card { background: var(--surface); border: 1px solid #333; border-radius: 16px; padding: 16px; margin-bottom: 20px; }
        iframe { width: 100%; border: none; border-radius: 12px; }
        #weather-info { font-size: 18px; font-weight: bold; }
    </style>
</head>
<body id="body">

    <div class="vibe-card">
        <div id="live-clock">--:--:--</div>
        <div id="weather-info">Loading weather...</div>
    </div>

    <!-- Music & Steam here -->
    <div class="vibe-card">
        <iframe src="https://open.spotify.com/embed/playlist/2CYaNy5UXj7YEC1ObftXgG?utm_source=generator" height="152"></iframe>
    </div>

    <div class="vibe-card">
        <iframe src="https://steamid.uk/profile/76561199709660579" height="300"></iframe>
    </div>

<script>
    // 1. Time-based Mood
    function updateMood() {
        const hour = new Date().getHours();
        const body = document.getElementById('body');
        if (hour < 12) body.className = 'morning';
        else if (hour < 20) body.className = 'evening';
        else body.className = 'night';
        document.getElementById('live-clock').innerText = new Date().toLocaleTimeString();
    }

    // 2. Weather Fetch (Adelaide coordinates)
    async function getWeather() {
        try {
            const res = await fetch('https://api.open-meteo.com/v1/forecast?latitude=-34.9285&longitude=138.6007&current=temperature_2m,weather_code');
            const data = await res.json();
            document.getElementById('weather-info').innerText = `Adelaide: ${data.current.temperature_2m}°C`;
        } catch (e) {
            document.getElementById('weather-info').innerText = "Weather offline";
        }
    }

    setInterval(updateMood, 1000);
    getWeather();
    updateMood();
</script>
</body>
</html>
